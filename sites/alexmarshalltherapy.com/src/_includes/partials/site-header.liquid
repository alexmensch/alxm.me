<a class="[ button skip-link ]" href="#main-content">Skip to content</a>
<header role="banner" class="site-header">
    <div class="[ center ] [ wrapper ] [ gutter ]">
        <div class="[ cluster site-header__inner ] [ flow-space-s font-sans ]" data-state="repel">
            <a href="/" aria-label="{{ site.siteName }} - Home" class="[ site-header__brand ] [ text-2 weight-black ]">
                {{ site.siteName }}
            </a>
            <nav class="[ nav ] [ flow-space-xs weight-extra-bold ]" aria-label="Primary">
                <ul class="cluster">
                    {% for item in site.nav %}
                        {% unless item.hidden %}
                            <li>
                                <a
                                    href="{{ item.url | remove_last: "/" }}"
                                    {{ item.url | getLinkActiveState: page.url }}
                                    >
                                    {{ item.title }}
                                </a>
                            </li>
                        {% endunless %}
                    {% endfor %}
                </ul>
            </nav>
        </div>
    </div>
</header>
