{% comment %}
  og:image must be an absolute URL — social platforms reject relative paths.
  Defaults to the static fallback card (site.og.defaultImage); a page can
  override it by setting `ogImage` (an absolute URL) in front matter. Per-article
  cards point `ogImage` under site.og.generatedDir, which the eleventy.after hook
  in .eleventy.js renders at build time.
{% endcomment %}
{% if ogImage %}
    {% assign og_image = ogImage %}
{% else %}
    {% capture og_image %}https://{{ site.domain }}{{ site.og.defaultImage }}{% endcapture %}
{% endif %}
{% capture og_image_alt %}{{ site.authorName }} — {{ site.authorRole }}{% endcapture %}
{% if summary %}
    <meta property="og:description" content="{{ summary }}" />
{% endif %}
    <meta property="og:type" content="website" />
    <meta name="title" property="og:title" content="{{ pageTitle }}" />
    <meta property="og:url" content="https://{{ site.domain }}{{ page.url }}" />
    <meta name="locale" property="og:locale" content="en_GB" />
    <meta property="og:image" content="{{ og_image }}" />
    <meta property="og:image:width" content="{{ site.og.width }}" />
    <meta property="og:image:height" content="{{ site.og.height }}" />
    <meta property="og:image:alt" content="{{ og_image_alt }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="{{ og_image }}" />
    <meta name="twitter:image:alt" content="{{ og_image_alt }}" />
