<!DOCTYPE html>
<html lang="en">
    <head>
        {% capture pageTitle %}{{ title }} • {{ site.siteName }}{% endcapture %}
        <title>{{ pageTitle }}</title>
        {% if canonical_url %}
            {% assign canonicalUrl = canonical_url %}
        {% else %}
            {% capture canonicalUrl %}https://{{ site.domain }}{{ page.url }}{% endcapture %}
        {% endif %}
        {% render "partials/site-meta" meta: meta, summary: summary, site: site, eleventy: eleventy, canonicalUrl: canonicalUrl %}
        {% render "partials/site-opengraph" pageTitle: pageTitle, summary: summary, site: site, ogImage: ogImage, canonicalUrl: canonicalUrl %}
        {% render "partials/site-schema" site: site, page: page, canonicalUrl: canonicalUrl, layout: layout, schemaType: schemaType, title: title, date: date, version_date: version_date, summary: summary, meta: meta, image: image, medium: medium, size: size, price: price, available: available %}
        {% render "partials/site-includes" site: site, eleventy: eleventy %}
    </head>
    <body>
        <div class="[ flow ] [ site-wrap ] [ flow-space-xl ]">
            {%unless hide_header %}
                {% render "partials/site-header"
                    site: site,
                    page: page
                    %}
            {%endunless %}
            <main tabindex="-1" id="main-content">
                <div class="[ center ] [ wrapper ] [ gutter ]">
                    {{ content }}
                </div>
            </main>
            {%unless hide_footer %}
                {% render "partials/site-footer"
                    helpers: helpers,
                    site: site,
                    page: page,
                    company_info: company_info %}
            {%endunless %}
        </div>
    </body>
</html>
