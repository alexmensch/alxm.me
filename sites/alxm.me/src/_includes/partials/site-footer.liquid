<footer role="contentinfo" class="[ center ] [ wrapper site-footer ] [ gutter ]">
    <div class="[ flow ] [ site-footer__content ] [ flow-space-l measure-reset ]">
        <nav class="[ nav ] [ flow-space-xs text-0 weight-extra-bold ]">
            <ul class="[ cluster ] [ font-sans ]">
                {% for item in site.nav %}
                    {% unless item.hidden or not item.footer %}
                        <li>
                            <a
                                href="{{ item.url | remove_last: "/" }}"
                                >
                                {{ item.title }}
                            </a>
                        </li>
                    {% endunless %}
                {% endfor %}
            </ul>
        </nav>
        {%if company_info %}
            <div class="flow">
                <p>Services are provided via {{ site.company.shortName }} (&numero;{{ site.company.number }}), a limited company registered in {{ site.company.jurisdiction }} with VAT number {{ site.company.vat }}. Read our <a href="/privacy">privacy policy</a>.</p>
                <address class="flow-space-2xs">{{ site.company.name }}, {{ site.company.address }}</address>
            </div>
        {%endif %}
        <div class="cluster" data-state="repel">
            <p>Copyright &copy; {{ helpers.currentYear }} {{ site.authorName }}</p>
            <p>Powered by <a href="https://www.11ty.dev/">Eleventy</a>, source code on <a href="https://github.com/alexmensch/alxm.me">Github</a>.</p>
        </div>
    </div>
</footer>
