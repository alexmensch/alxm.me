---
layout: layouts/base
---

<section class="[ cover ] [ artwork__preview ] [ flow-space-m padding-m ]">
  <div class="artwork__preview-container" data-target>
    <div class="artwork__preview-grid">
      <div class="frame" data-fit-content data-ratio="{{ ratio }}" {%- if landscape %}data-landscape{%- endif %}>
        <a href="/artwork/#{{ page_slug }}">
          <img src="{{ image }}" alt="{{ title }}" />
        </a>
      </div>
      <div>
        <div class="[ box flow ] [ border-thin border-style-solid flow-space-m leading-tight measure-mini padding-s radius ]" data-fit-content>
          <p><em>{{ title }}</em></p>
          {%- if meta.description %}
          <p>{{ meta.description | markdownify }}</p>
          {%- endif %}
          <p>{{ size.width }} x {{ size.height }}, {{ medium }}</p>
          {%- if available  %}
          <p>{{ price }}, <a href="/contact">contact</a> to purchase</p>
          {%- else %}
          <p>Sold</p>
          {%- endif  %}
        </div>
      </div>
    </div>
  </div>
</section>
