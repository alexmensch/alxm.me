---
layout: layouts/base
---
<div class="[ center flow ] [ wrapper ] [ gutter ]">
  <section class="[ cluster intro ] [ flow-space-xs ]" data-state="reversed">
    <div class="intro__header">
      <h1 class="weight-bold">
        {{ intro.main }}
      </h1>
    </div>
    <div class="intro__content">
      <p>{{ intro.summary }}</p>
    </div>
  </section>
  <article class="[ flow ]">
    {{ content }}
  </article>
</div>
