---
layout: layouts/base
---
<section class="cover">
  <div class="[ box center ] [ bg-light-glare padding-m radius ]" data-target data-shadow data-outline>
    <div class="[ stack ] [ padding-2xs ]">
      <div class="[ box ]">
        <h1 class="[ measure-compact text-mega--3 weight-bold ]">{{ main.title }}</h1>
      </div>
      <div class="[ box flow ] [ flow-space-m ]">
        {% for line in main.text %}
          <p class="measure-short">{{ line | markdownify }}</p>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
