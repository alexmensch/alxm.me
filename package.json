{
  "name": "alxm-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for alxm.me and alexmarshalltherapy.com",
  "scripts": {
    "prepare": "husky",
    "alxm:build": "cd sites/alxm.me && pnpm build",
    "alxm:build:cf": "cd sites/alxm.me && pnpm build:cf",
    "alxm:deploy": "cd sites/alxm.me && pnpm deploy",
    "alxm:deploy:stg": "cd sites/alxm.me && pnpm deploy:stg",
    "alxm:watch": "cd sites/alxm.me && pnpm 11ty:watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexmensch/alxm.me.git"
  },
  "author": "Alex Marshall",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
