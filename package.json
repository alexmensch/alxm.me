{
  "name": "alxm-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for alxm.me and alexmarshalltherapy.com",
  "scripts": {
    "prepare": "husky",
    "alxm:build": "cd sites/alxm.me && pnpm build",
    "alxm:build:cf": "cd sites/alxm.me && pnpm build:cf",
    "alxm:deploy": "cd sites/alxm.me && pnpm deploy",
    "alxm:deploy:stg": "cd sites/alxm.me && pnpm deploy:stg",
    "alxm:watch": "cd sites/alxm.me && pnpm 11ty:watch",
    "amt:build": "cd sites/alexmarshalltherapy.com && pnpm build",
    "amt:build:cf": "cd sites/alexmarshalltherapy.com && pnpm build:cf",
    "amt:deploy": "cd sites/alexmarshalltherapy.com && pnpm deploy",
    "amt:deploy:stg": "cd sites/alexmarshalltherapy.com && pnpm deploy:stg",
    "amt:watch": "cd sites/alexmarshalltherapy.com && pnpm 11ty:watch",
    "test:packages": "pnpm -r --filter \"./packages/*\" test",
    "lint:packages": "pnpm run lint:packages:js && pnpm run lint:packages:css",
    "lint:packages:js": "eslint packages",
    "lint:packages:css": "stylelint \"packages/**/*.scss\"",
    "check:packages": "pnpm run lint:packages && pnpm run test:packages"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexmensch/alxm.me.git"
  },
  "author": "Alex Marshall",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0"
  }
}
